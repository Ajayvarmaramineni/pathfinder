<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button android:id="@+id/programs_btn" style="@style/MenuButton" android:text="@string/programs" />
        <Button android:id="@+id/courses_btn" style="@style/MenuButton" android:text="@string/courses" />
        <Button android:id="@+id/faculty_btn" style="@style/MenuButton" android:text="@string/faculty" />
        <Button android:id="@+id/offices_btn" style="@style/MenuButton" android:text="@string/offices" />
        <Button android:id="@+id/buildings_btn" style="@style/MenuButton" android:text="@string/buildings" />
        <Button android:id="@+id/housing_dining_btn" style="@style/MenuButton" android:text="@string/housing_dining" />
        <Button android:id="@+id/project_centers_btn" style="@style/MenuButton" android:text="@string/project_centers" />
        <Button android:id="@+id/research_centers_btn" style="@style/MenuButton" android:text="@string/research_centers" />
        <Button android:id="@+id/search_btn" style="@style/MenuButton" android:text="@string/search" />
        <Button android:id="@+id/reports_btn" style="@style/MenuButton" android:text="@string/reports" />
    </LinearLayout>

</ScrollView>
